<?xml version="1.0" encoding="UTF-8"?>
<project name="northstar-claims" default="war" basedir=".">
    <property name="src" location="src/main/java"/>
    <property name="web" location="src/main/webapp"/>
    <property name="resources" location="src/main/resources"/>
    <property name="build" location="target/ant"/>
    <property name="classes" location="${build}/classes"/>
    <property name="war" location="target/northstar-claims-management-ant.war"/>
    <path id="compile.path">
        <fileset dir="${build}/lib" erroronmissingdir="false"/>
        <fileset dir="${user.home}/.m2/repository">
            <include name="**/struts-core/1.3.10/*.jar"/>
            <include name="**/struts-taglib/1.3.10/*.jar"/>
            <include name="**/servlet-api/2.4/*.jar"/>
            <include name="**/jsp-api/2.0/*.jar"/>
            <include name="**/commons-logging/*/*.jar"/>
            <include name="**/commons-validator/*.jar"/>
            <include name="**/hsqldb/2.7.3/*.jar"/>
        </fileset>
    </path>
    <target name="prepare">
        <mkdir dir="${classes}"/>
        <mkdir dir="target"/>
        <mkdir dir="${build}/lib"/>
        <copy todir="${build}/lib">
            <fileset dir="${user.home}/.m2/repository">
                <include name="**/struts-core/1.3.10/*.jar"/>
                <include name="**/struts-taglib/1.3.10/*.jar"/>
                <include name="**/struts-extras/1.3.10/*.jar"/>
                <include name="**/commons-logging/*/*.jar"/>
                <include name="**/hsqldb/2.7.3/*.jar"/>
                <include name="**/jstl/1.1.2/*.jar"/>
                <include name="**/standard/1.1.2/*.jar"/>
            </fileset>
        </copy>
    </target>
    <target name="compile" depends="prepare">
        <javac srcdir="${src}" destdir="${classes}" source="11" target="11"
               includeantruntime="false" encoding="UTF-8">
            <classpath refid="compile.path"/>
        </javac>
        <copy todir="${classes}">
            <fileset dir="${resources}"/>
        </copy>
    </target>
    <target name="war" depends="compile">
        <war destfile="${war}" webxml="${web}/WEB-INF/web.xml">
            <fileset dir="${web}">
                <exclude name="WEB-INF/web.xml"/>
            </fileset>
            <classes dir="${classes}"/>
            <lib dir="${build}/lib"/>
        </war>
    </target>
</project>
