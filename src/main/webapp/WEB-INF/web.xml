<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC
    "-//Sun Microsystems, Inc.//DTD Web Application 2.4//EN"
    "http://java.sun.com/dtd/web-app_2_4.dtd">
<web-app>
    <!-- Servlet 2.4 descriptors keep deployment decisions outside Java code. -->
    <!-- The default module uses flat paths under the claims context. -->
    <!-- The admin module is loaded separately by the config/admin parameter. -->
    <!-- Authentication is deliberately applied to every Struts request. -->
    <!-- Static resources are served by the container outside this filter. -->
    <!-- The resource reference documents the preferred container connection. -->
    <!-- The env-entry supplies the URL fallback used by command-line support. -->
    <!-- Error forwarding keeps stack traces out of operator-facing pages. -->
    <!-- The welcome file begins at the session login screen. -->
    <!-- JSP pages remain under WEB-INF so users enter through actions. -->
    <!-- Message resources are selected by the Struts module descriptors. -->
    <!-- Validator rules are initialized during ActionServlet startup. -->
    <!-- File database paths can be changed with the claims.db.path property. -->
    <!-- No annotation scanning is required by this deployment descriptor. -->
    <!-- The application remains compatible with the original servlet contract. -->
    <!-- Container-managed resources may be unavailable in local Jetty runs. -->
    <!-- JDBC fallback behavior is handled by the DAO connection pool. -->
    <display-name>NorthStar Claims</display-name>
    <description>Claims operations web application.</description>
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.localizationContext</param-name>
        <param-value>ApplicationResources</param-value>
    </context-param>
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.fallbackLocale</param-name>
        <param-value>en</param-value>
    </context-param>
    <env-entry>
        <description>Fallback database URL used when JNDI is unavailable.</description>
        <env-entry-name>jdbc/ClaimsDBUrl</env-entry-name>
        <env-entry-type>java.lang.String</env-entry-type>
        <env-entry-value>jdbc:hsqldb:file:${java.io.tmpdir}/northstar-claims-db</env-entry-value>
    </env-entry>
    <servlet>
        <servlet-name>action</servlet-name>
        <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
        <init-param>
            <param-name>config</param-name>
            <param-value>/WEB-INF/struts-config.xml,/WEB-INF/struts-config-claims.xml</param-value>
        </init-param>
        <init-param>
            <param-name>config/admin</param-name>
            <param-value>/WEB-INF/struts-config-admin.xml</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>0</param-value>
        </init-param>
        <init-param>
            <param-name>detail</param-name>
            <param-value>0</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>action</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>login.do</welcome-file>
    </welcome-file-list>
    <resource-ref>
        <description>HSQLDB claims data source</description>
        <res-ref-name>jdbc/ClaimsDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
    <filter>
        <filter-name>formPopulationFilter</filter-name>
        <filter-class>com.northstar.claims.web.FormPopulationFilter</filter-class>
    </filter>
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.northstar.claims.web.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>formPopulationFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
</web-app>
