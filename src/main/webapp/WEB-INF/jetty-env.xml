<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC
    "-//Mort Bay Consulting//DTD Configure//EN"
    "http://www.eclipse.org/jetty/configure_9_0.dtd">
<Configure
    id="wac"
    class="org.eclipse.jetty.webapp.WebAppContext">
    <New
        id="claimsDb"
        class="org.eclipse.jetty.plus.jndi.Resource">
        <Arg>
            <Ref refid="wac" />
        </Arg>
        <Arg>jdbc/ClaimsDB</Arg>
        <Arg>
            <New class="org.hsqldb.jdbc.JDBCDataSource">
                <Set name="Database">
                    <SystemProperty
                        name="claims.db.url"
                        default="jdbc:hsqldb:file:target/db/northstar" />
                </Set>
                <Set name="User">
                    <SystemProperty
                        name="claims.db.user"
                        default="CLAIMS_APP" />
                </Set>
                <Set name="Password">
                    <SystemProperty
                        name="claims.db.password"
                        default="" />
                </Set>
            </New>
        </Arg>
    </New>
</Configure>
