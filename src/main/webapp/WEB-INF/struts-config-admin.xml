<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 1.2//EN"
    "http://struts.apache.org/dtds/struts-config_1_2.dtd">
<struts-config>
    <global-forwards>
        <forward
            name="denied"
            path="/WEB-INF/jsp/denied.jsp" />
    </global-forwards>
    <action-mappings>
        <action
            path="/adjusters"
            type="com.northstar.claims.web.admin.AdjusterAdminAction"
            name="adjusterForm"
            scope="request"
            validate="false">
            <forward
                name="adjusters"
                path="/WEB-INF/jsp/admin/adjusters.jsp" />
            <forward
                name="editAdjuster"
                path="/WEB-INF/jsp/admin/editAdjuster.jsp" />
        </action>
        <action
            path="/reference"
            type="com.northstar.claims.web.admin.ReferenceDataAction"
            validate="false">
            <forward
                name="reference"
                path="/WEB-INF/jsp/admin/reference.jsp" />
        </action>
    </action-mappings>
    <message-resources
        parameter="ApplicationResources" />
</struts-config>
